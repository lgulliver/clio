{
  "name": "@clio/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "worker:mock": "node --env-file-if-exists=.env src/worker-mock.ts",
    "worker:github": "node --env-file-if-exists=.env src/worker-github.ts",
    "worker:argo": "node --env-file-if-exists=.env src/worker-argo.ts",
    "worker:measurement": "node --env-file-if-exists=.env src/worker-measurement.ts",
    "worker:space-github": "node --env-file-if-exists=.env src/worker-space-github.ts",
    "worker:notifications": "node --env-file-if-exists=.env src/worker-notifications.ts"
  },
  "dependencies": {
    "@clio/adapters": "workspace:*",
    "@clio/oems": "workspace:*",
    "@fastify/cors": "11.3.1",
    "better-auth": "1.7.7",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "nodemailer": "10.1.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@clio/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
