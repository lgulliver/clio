{
  "name": "@clio/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "better-auth": "1.7.7",
    "@fastify/cors": "11.3.1"
  },
  "devDependencies": {
    "@clio/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
