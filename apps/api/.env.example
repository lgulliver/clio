# Server-only configuration. Copy values into your shell or ignored .env file.
# Package dev/start/migrate commands load .env when present.
# For direct Node use: node --env-file=.env src/main.ts.
DATABASE_URL=postgres://clio_dev:clio_dev_password@127.0.0.1:5432/clio_dev
HOST=127.0.0.1
PORT=3000

# Optional as a complete group. Leave ALL five unset for health-only operation.
# Generate AUTH_SECRET with: openssl rand -base64 32
# AUTH_SECRET=
# AUTH_BASE_URL=http://localhost:3000
# APP_ORIGIN=http://localhost:5173
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Register separate development GitHub OAuth app callback:
# http://localhost:3000/api/auth/callback/github
# Production requires HTTPS for AUTH_BASE_URL and APP_ORIGIN.

# Optional local live GitHub collection: separate from login OAuth.
# All three absent disables connections; partial/invalid config fails startup.
# Private regular owner-only files outside checkout; absolute paths (no $HOME expansion).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/absolute/private/path/app-key.pem
# GITHUB_APP_GRANTS_FILE=/absolute/private/path/github-grants.json
# Grants: workspaceId, installationId, accountId, accountType, repositoryIds.
# Restart API + GitHub worker together after credential/grant changes.

# Optional native Argo notification ingestion, separate from login and GitHub.
# Matching workspace/service/Application grants reference private token files.
# Private regular owner-only files outside every Git checkout; no symlinks.
# ARGO_INGESTION_GRANTS_FILE=/absolute/private/path/argo-grants.json
# Restart API + Argo worker together after credential/grant changes.

# Optional independent enrichment producers; requires native Argo configuration.
# Array entries: sourceId,producerId,capability,policyReference,repositoryIds,tokenFile.
# Distinct producer UUIDs and private credentials per capability.
# application_provenance repositoryIds: explicit namespaced identities; consumer_exposure: [].
# ARGO_ENRICHMENT_GRANTS_FILE=/absolute/private/path/argo-enrichment-grants.json
# Independent historical-import grants; exact native scope plus producer/journal/policy.
# Owner-only JSON and token files outside Git. Never reuse native/enrichment credentials.
# ARGO_ARCHIVE_GRANTS_FILE=/absolute/private/argo-archive-grants.json

# Optional independent measurement authorities for GitHub or Argo saved bases.
# Distinct owner-only tokens, outside Git, separate from all collection credentials.
# Grants: workspaceId,serviceId,provider,source,producerId,capability,name,policyRef,
# productionPaths,repositoryIds,tokenFile. See docs/providers/connect-measurement-evidence.md.
# Restart API + measurement worker together after all grant/credential changes.
# CLIO_MEASUREMENT_GRANTS_FILE=/absolute/private/measurement-grants.json
