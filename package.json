{
  "name": "clio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^24.15.0",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "dev": "pnpm --filter @clio/web dev",
    "build": "pnpm --filter @clio/web build",
    "preview": "pnpm --filter @clio/web preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm --filter @clio/web test:watch",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:api": "pnpm --filter @clio/api dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "pnpm --filter @clio/api migrate",
    "test:integration": "pnpm --filter @clio/api test:integration",
    "demo:providers": "pnpm --filter @clio/adapters demo",
    "worker:mock": "pnpm --filter @clio/api worker:mock",
    "worker:github": "pnpm --filter @clio/api worker:github",
    "worker:argo": "pnpm --filter @clio/api worker:argo",
    "argo:journal": "node infra/argocd/journal/cli.ts",
    "argo:capture": "node infra/argocd/capture/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2"
  }
}
