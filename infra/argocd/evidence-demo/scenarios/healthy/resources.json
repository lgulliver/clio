            }
          },
          "spec": {
            "containers": [
              {
                "name": "http",
                "image": "docker.io/library/nginx:1.29.3-alpine@sha256:b3c656d55d7ad751196f21b7fd2e8d4da9cb430e32f646adcf92441b72f82b14",
                "ports": [
                  {
