                  },
                  {
                    "name": "health",
                    "mountPath": "/etc/nginx/conf.d/default.conf",
                    "subPath": "default.conf",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "artifact",
                "configMap": {
                  "name": "artifact-98db8efd4d9bcfe0cbec4d4bdea5e2e826723c64c90e37e9ffd27f3936f9a089"
