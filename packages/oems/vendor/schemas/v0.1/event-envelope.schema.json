{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence event envelope",
  "description": "OEMS v0.1 working draft; semantic constraints also apply.",
  "type": "object",
  "required": [
    "spec_version",
    "dataset_id",
    "event_id",
    "record_type",
    "occurred_at",
    "observed_at",
    "source_refs",
    "payload"
  ],
  "properties": {
    "spec_version": {
      "const": "0.1-draft"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "enum": [
        "service",
        "change",
        "deployment",
        "incident"
      ]
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,6})?([Zz]|\\+[0-9]{2}:[0-9]{2}|-(?!00:00)[0-9]{2}:[0-9]{2})$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,6})?([Zz]|\\+[0-9]{2}:[0-9]{2}|-(?!00:00)[0-9]{2}:[0-9]{2})$"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
