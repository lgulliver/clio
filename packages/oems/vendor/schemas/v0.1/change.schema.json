{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Change",
  "description": "OEMS v0.1 draft contract; semantic constraints also apply.",
  "type": "object",
  "required": [
    "id",
    "repository_id",
    "commit_id",
    "committed_at",
    "source_refs",
    "observed_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1
    },
    "extensions": {
      "type": "object"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "commit_id": {
      "type": "string",
      "minLength": 1
    },
    "committed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,6})?([Zz]|\\+[0-9]{2}:[0-9]{2}|-(?!00:00)[0-9]{2}:[0-9]{2})$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,6})?([Zz]|\\+[0-9]{2}:[0-9]{2}|-(?!00:00)[0-9]{2}:[0-9]{2})$"
    }
  },
  "additionalProperties": false
}
